# Settings for the backend. Spring Boot does NOT read a .env file by itself: set these as
# environment variables (IntelliJ: Run > Edit Configurations > Environment variables;
# Windows: setx NAME value; macOS/Linux: export NAME=value). Never commit real values.
# Everything except JWT_SECRET is optional for local development.
DB_URL=jdbc:mysql://localhost:3306/college_notice_board?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
DB_USERNAME=gaurav
DB_PASSWORD=gaurav

# At least 64 characters
JWT_SECRET=replace-with-a-long-random-string-of-at-least-sixty-four-characters-0123456789

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

MAIL_ENABLED=false
MAIL_USERNAME=
MAIL_PASSWORD=

AI_API_KEY=

# Shown on the public website
COLLEGE_NAME=ABC College
COLLEGE_ADDRESS=College Road, Pimpri, Pune, Maharashtra 411018
COLLEGE_PHONE=+91 20 0000 0000
COLLEGE_ADMISSION_PHONE=+91 20 0000 0001
COLLEGE_EMAIL=info@college.edu
FRONTEND_URL=http://localhost:5173
SEED_DATA=true
AUTO_ACTIVATE_REGISTRATIONS=false
